# ana-related -- root-only, so docs/output/ (image assets) is tracked.
/output/
/data/
packages/anatools/

# in case anatools is included for testing
packages/anatools

*.egg-info
.pytest_cache/
__pycache__/
*.hold
*.log

# don't put compiled or diff files in the repository
*.pyc
*.blend1
*.uni
*.vdb

# don't put graphics in the repository
# ...except for the hero screenshots referenced from README + channel.md.
*.png
!docs/output/*.png
*.tif
*.jpg
*.pkl
*.stl
*.data
*.dat

# no zip files
*.zip
*.rar
*.tar.gz
*.bz2
*.npz

# ignore vscode settings
*.vscode*
*.code-workspace

# ignore jupyter checkpoints
*checkpoint.ipynb

# ignore os-related files
.DS_Store

node_data.json
graphs/detective_room_test.yml

# session-local handoff scratchpad, never shipped
HANDOFF.md
HANDOFF.local.md
